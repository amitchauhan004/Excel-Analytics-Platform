# XcelFlow Backend Environment Configuration Example
# Copy this file to .env and fill in your actual credentials. DO NOT commit .env to GitHub!

# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas cloud URL)
MONGO_URI=mongodb://localhost:27017/excel_analytics

# JWT Secret for User Authentication
JWT_SECRET=your_secure_jwt_secret_key_here

# OpenRouter / OpenAI API Key (For AI Insights & Decision Intelligence Features)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Google OAuth Credentials (For Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Nodemailer Configuration (For Email Notifications & Password Resets)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_16_digit_app_password
NOTIFICATION_EMAIL=your_email@gmail.com

# Admin Account Seeding Credentials
ADMIN_EMAIL=admin@xcelflow.com
ADMIN_PASSWORD=your_admin_password_here

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
